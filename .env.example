# Copy to .env and adjust. Every value is optional; the defaults below are used when unset.

# ParaBank web root (must end with /parabank/). The REST API is derived from it: <BASE_URL>services/bank/
BASE_URL=https://parabank.parasoft.com/parabank/

# Parallel workers. Keep this low: the public instance sits behind a Cloudflare rate limit
# (HTTP 429 / error 1015). See docs/RELIABILITY.md.
WORKERS=2

# When Cloudflare answers 429, the API client waits for Retry-After and retries,
# but only if the wait is at most this many seconds. Longer waits fail fast with a clear message.
MAX_RATE_LIMIT_WAIT_SEC=60
